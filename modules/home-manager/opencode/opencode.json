{
  "$schema": "https://opencode.ai/config.json",
  "default_agent": "assistant",
  "subagent_depth": 3,
  "small_model": "opencode/big-pickle",
  "agent": {
    "quick": {
      "model": "opencode/big-pickle",
      "reasoningEffort": "low",
      "prompt": "{file:./agent-prompts/quick.md}",
      "description": "Lightweight primary workflow for simple, low-risk tasks",
      "color": "#9ccc65",
      "permission": {
        "trivy_*": "deny",
        "sonarqube_*": "deny",
        "read": {
          "*": "allow",
          "*.env": "deny",
          "*.env.*": "deny",
          "*.env.example": "allow"
        },
        "bash": {
          "*": "ask",
          "git status*": "allow",
          "git log*": "allow",
          "git diff*": "allow",
          "git show*": "allow",
          "rg *": "allow",
          "ls *": "allow",
          "ls": "allow",
          "pwd": "allow"
        },
        "task": {
          "*": "deny"
        },
        "edit": "ask",
        "gitea_*": "deny",
        "engram_mem_*": "deny",
        "engram_mem_context": "allow",
        "engram_mem_search": "allow",
        "engram_mem_get_observation": "allow",
        "engram_mem_suggest_topic_key": "allow",
        "engram_mem_current_project": "allow",
        "codegraph_*": "deny",
        "context7_*": "deny"
      },
      "mode": "primary"
    },
    "assistant": {
      "model": "openai/gpt-5.6-sol",
      "variant": "balanced",
      "prompt": "{file:./agent-prompts/assistant.md}",
      "description": "User-facing collaborative workflow for questions, analysis, and guided task support",
      "color": "#4fc3f7",
      "permission": {
        "sonarqube_*": "deny",
        "bash": {
          "git commit*": "ask",
          "git push*": "ask",
          "git rebase*": "ask",
          "git reset*": "ask",
          "git clean*": "ask",
          "git restore*": "ask",
          "git checkout*": "ask",
          "sudo *": "ask",
          "su *": "ask",
          "doas *": "ask",
          "rm*": "ask",
          "rmdir*": "ask",
          "unlink*": "ask",
          "shred*": "ask"
        },
        "task": {
          "*": "deny",
          "investigate": "allow",
          "reviewer": "allow",
          "verifier": "allow",
          "browser": "allow",
          "general": "allow"
        },
        "gitea_*": "deny",
        "engram_mem_save_prompt": "deny"
      },
      "mode": "primary"
    },
    "build": {
      "model": "openai/gpt-5.6-sol",
      "variant": "balanced",
      "prompt": "{file:./agent-prompts/build.md}",
      "description": "Primary implementation agent; delegate discovery to investigate, risk analysis to reviewer, and proof checks to verifier",
      "color": "#ffb74d",
      "permission": {
        "sonarqube_*": "deny",
        "task": {
          "*": "deny",
          "investigate": "allow",
          "reviewer": "allow",
          "verifier": "allow",
          "browser": "allow",
          "worker": "allow",
          "spec-writer": "allow",
          "general": "allow"
        },
        "bash": {
          "git status*": "allow",
          "git log*": "allow",
          "git diff*": "allow",
          "git show*": "allow",
          "rg *": "allow",
          "ls *": "allow",
          "ls": "allow",
          "pwd": "allow",
          "git commit*": "ask",
          "git push*": "ask",
          "git rebase*": "ask",
          "git reset*": "ask",
          "git clean*": "ask",
          "git restore*": "ask",
          "git checkout*": "ask",
          "sudo *": "ask",
          "su *": "ask",
          "doas *": "ask",
          "rm*": "ask",
          "rmdir*": "ask",
          "unlink*": "ask",
          "shred*": "ask"
        },
        "gitea_*": "deny",
        "engram_mem_save_prompt": "deny"
      },
      "mode": "primary"
    },
    "plan": {
      "model": "openai/gpt-5.6-sol",
      "variant": "balanced",
      "prompt": "{file:./agent-prompts/plan.md}",
      "description": "Read-only planning workflow for scope clarification, sequencing, and risk-aware execution plans",
      "color": "#ba68c8",
      "permission": {
        "trivy_*": "deny",
        "sonarqube_*": "deny",
        "task": {
          "*": "deny",
          "investigate": "allow",
          "reviewer": "allow",
          "browser": "allow",
          "spec-writer": "allow"
        },
        "edit": "deny",
        "bash": {
          "*": "deny",
          "pwd": "allow",
          "ls *": "allow",
          "ls": "allow",
          "git status*": "allow",
          "git log*": "allow",
          "git diff*": "allow",
          "rg *": "allow"
        },
        "gitea_*": "deny",
        "engram_mem_*": "deny",
        "engram_mem_context": "allow",
        "engram_mem_search": "allow",
        "engram_mem_get_observation": "allow",
        "engram_mem_suggest_topic_key": "allow",
        "engram_mem_current_project": "allow"
      },
      "mode": "primary"
    },
    "investigate": {
      "mode": "subagent",
      "model": "openai/gpt-5.6-terra",
      "variant": "fast",
      "prompt": "{file:./agent-prompts/investigate.md}",
      "description": "Use for fast read-only research, repo exploration, and web lookups before implementation decisions",
      "color": "#64b5f6",
      "permission": {
        "sonarqube_*": "deny",
        "read": {
          "*.env": "deny",
          "*.env.*": "deny",
          "*.env.example": "allow"
        },
        "edit": "deny",
        "external_directory": "deny",
        "doom_loop": "deny",
        "question": "deny",
        "compress": "deny",
        "bash": {
          "*": "deny"
        },
        "task": {
          "*": "deny"
        },
        "gitea_*": "deny",
        "engram_mem_*": "deny",
        "engram_mem_context": "allow",
        "engram_mem_search": "allow",
        "engram_mem_get_observation": "allow",
        "engram_mem_suggest_topic_key": "allow",
        "engram_mem_current_project": "allow"
      }
    },
    "reviewer": {
      "mode": "subagent",
      "model": "openai/gpt-5.6-sol",
      "variant": "deep",
      "prompt": "{file:./agent-prompts/reviewer.md}",
      "description": "Use for deep code/PR review: logic bugs, regressions, duplication, scalability limits, and reliability issues",
      "color": "#e57373",
      "permission": {
        "read": {
          "*.env": "deny",
          "*.env.*": "deny",
          "*.env.example": "allow"
        },
        "edit": "deny",
        "external_directory": "deny",
        "doom_loop": "deny",
        "question": "deny",
        "compress": "deny",
        "bash": {
          "*": "deny",
          "opencode-candidate-id*": "allow"
        },
        "task": {
          "*": "deny",
          "browser": "allow"
        },
        "gitea_*": "deny",
        "engram_mem_*": "deny",
        "engram_mem_context": "allow",
        "engram_mem_search": "allow",
        "engram_mem_get_observation": "allow",
        "engram_mem_suggest_topic_key": "allow",
        "engram_mem_current_project": "allow"
      }
    },
    "verifier": {
      "mode": "subagent",
      "model": "openai/gpt-5.6-terra",
      "variant": "fast",
      "prompt": "{file:./agent-prompts/verifier.md}",
      "description": "Use when claims need proof: run tests/checks, inspect outputs, and report evidence-based verification results",
      "color": "#4db6ac",
      "permission": {
        "sonarqube_*": "deny",
        "read": {
          "*.env": "deny",
          "*.env.*": "deny",
          "*.env.example": "allow"
        },
        "bash": {
          "git commit*": "deny",
          "git push*": "deny",
          "git rebase*": "deny",
          "git reset*": "deny",
          "git clean*": "deny",
          "git restore*": "deny",
          "git checkout*": "deny",
          "sudo *": "deny",
          "su *": "deny",
          "doas *": "deny",
          "rm*": "deny",
          "rmdir*": "deny",
          "unlink*": "deny",
          "shred*": "deny"
        },
        "edit": "deny",
        "webfetch": "deny",
        "external_directory": "deny",
        "doom_loop": "deny",
        "question": "deny",
        "compress": "deny",
        "task": {
          "*": "deny",
          "browser": "allow"
        },
        "gitea_*": "deny",
        "engram_mem_*": "deny",
        "engram_mem_context": "allow",
        "engram_mem_search": "allow",
        "engram_mem_get_observation": "allow",
        "engram_mem_suggest_topic_key": "allow",
        "engram_mem_current_project": "allow"
      }
    },
    "spec-writer": {
      "mode": "subagent",
      "model": "openai/gpt-5.6-terra",
      "variant": "fast",
      "prompt": "{file:./agent-prompts/spec-writer.md}",
      "description": "Writes and updates local temporary planning specs under .opencode/specs only",
      "hidden": true,
      "permission": {
        "trivy_*": "deny",
        "sonarqube_*": "deny",
        "read": {
          "*.env": "deny",
          "*.env.*": "deny",
          "*.env.example": "allow"
        },
        "edit": {
          "*": "deny",
          ".opencode/specs/**": "allow"
        },
        "bash": {
          "*": "deny"
        },
        "external_directory": "deny",
        "doom_loop": "deny",
        "question": "deny",
        "compress": "deny",
        "task": {
          "*": "deny"
        },
        "gitea_*": "deny",
        "engram_mem_*": "deny",
        "engram_mem_context": "allow",
        "engram_mem_search": "allow",
        "engram_mem_get_observation": "allow",
        "engram_mem_suggest_topic_key": "allow",
        "engram_mem_current_project": "allow"
      }
    },
    "general": {
      "mode": "subagent",
      "model": "openai/gpt-5.6-terra",
      "variant": "fast",
      "prompt": "{file:./agent-prompts/general.md}",
      "description": "Fallback delegated agent for mixed tasks that do not clearly fit investigate, reviewer, or verifier",
      "color": "#90a4ae",
      "permission": {
        "trivy_*": "deny",
        "sonarqube_*": "deny",
        "read": {
          "*.env": "deny",
          "*.env.*": "deny",
          "*.env.example": "allow"
        },
        "bash": {
          "*": "deny",
          "git status*": "allow",
          "git log*": "allow",
          "git diff*": "allow",
          "git show*": "allow",
          "rg *": "allow",
          "ls *": "allow",
          "ls": "allow",
          "pwd": "allow"
        },
        "task": {
          "*": "deny",
          "investigate": "allow",
          "reviewer": "allow",
          "verifier": "allow"
        },
        "edit": "deny",
        "external_directory": "deny",
        "doom_loop": "deny",
        "question": "deny",
        "compress": "deny",
        "gitea_*": "deny",
        "engram_mem_*": "deny",
        "engram_mem_context": "allow",
        "engram_mem_search": "allow",
        "engram_mem_get_observation": "allow",
        "engram_mem_suggest_topic_key": "allow",
        "engram_mem_current_project": "allow"
      }
    },
    "worker": {
      "mode": "subagent",
      "model": "openai/gpt-5.6-terra",
      "variant": "balanced",
      "prompt": "{file:./agent-prompts/worker.md}",
      "description": "Dedicated execution subagent for complex multi-step edits and tool-heavy implementation work",
      "color": "#ffd54f",
      "permission": {
        "sonarqube_*": "deny",
        "read": {
          "*.env": "deny",
          "*.env.*": "deny",
          "*.env.example": "allow"
        },
        "bash": {
          "git commit*": "deny",
          "git push*": "deny",
          "git rebase*": "deny",
          "git reset*": "deny",
          "git clean*": "deny",
          "git restore*": "deny",
          "rm*": "deny",
          "rmdir*": "deny",
          "unlink*": "deny",
          "shred*": "deny"
        },
        "task": {
          "*": "deny",
          "investigate": "allow",
          "reviewer": "allow",
          "browser": "allow",
          "verifier": "allow"
        },
        "external_directory": "deny",
        "doom_loop": "deny",
        "question": "deny",
        "compress": "deny",
        "gitea_*": "deny",
        "engram_mem_save_prompt": "deny"
      }
    },
    "browser": {
      "mode": "subagent",
      "model": "openai/gpt-5.6-terra",
      "variant": "fast",
      "prompt": "{file:./agent-prompts/browser.md}",
      "description": "Use Orca CLI for browser navigation, DOM, console, network, interactions, screenshots, and browser-visible verification",
      "color": "#42a5f5",
      "permission": "allow"
    },
    "gitea-repo": {
      "model": "openai/gpt-5.6-terra",
      "variant": "balanced",
      "prompt": "{file:./agent-prompts/gitea-repo.md}",
      "description": "User-facing Gitea repository management agent for issues, PRs, repo hygiene, and release/changelog workflows",
      "color": "#81c784",
      "permission": {
        "gitea_*": "deny",
        "gitea_get_*": "allow",
        "gitea_list_*": "allow",
        "gitea_search_*": "allow",
        "gitea_render_*": "allow",
        "gitea_create_*": "ask",
        "gitea_edit_*": "ask",
        "gitea_update_*": "ask",
        "gitea_request_*": "ask",
        "gitea_fork_*": "ask",
        "gitea_star_*": "ask",
        "gitea_unstar_*": "ask",
        "gitea_mark_*": "ask",
        "gitea_add_issue_*": "ask",
        "gitea_remove_issue_*": "ask",
        "gitea_admin_*": "deny",
        "gitea_delete_*": "deny",
        "gitea_transfer_*": "deny",
        "gitea_merge_*": "deny",
        "gitea_add_collaborator": "deny",
        "gitea_add_team_*": "deny",
        "gitea_remove_team_*": "deny",
        "gitea_create_org": "deny",
        "gitea_edit_org": "deny",
        "gitea_create_team": "deny",
        "gitea_get_runner_registration_token": "deny",
        "trivy_*": "deny",
        "sonarqube_*": "deny",
        "engram_mem_*": "deny",
        "engram_mem_context": "allow",
        "engram_mem_search": "allow",
        "engram_mem_get_observation": "allow",
        "engram_mem_suggest_topic_key": "allow",
        "engram_mem_current_project": "allow",
        "edit": "deny",
        "bash": {
          "*": "ask",
          "git *": "allow",
          "docker *": "allow",
          "docker compose *": "allow",
          "act*": "allow",
          "python*": "allow",
          "* test*": "allow",
          "* build*": "allow",
          "* lint*": "allow",
          "* typecheck*": "allow",
          "* check*": "allow",
          "* verify*": "allow",
          "* compile*": "allow",
          "rg *": "allow",
          "ls*": "allow",
          "pwd": "allow",
          "git commit*": "ask",
          "git push*": "ask",
          "git rebase*": "ask",
          "git reset*": "ask",
          "git clean*": "ask",
          "git restore*": "ask",
          "rm*": "ask",
          "rmdir*": "ask",
          "unlink*": "ask",
          "shred*": "ask"
        },
        "task": {
          "*": "deny",
          "investigate": "allow",
          "reviewer": "allow",
          "verifier": "allow",
          "general": "allow"
        }
      },
      "mode": "primary"
    }
  },
  "compaction": {
    "auto": true,
    "prune": true,
    "reserved": 30000
  }
}
